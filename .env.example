# ─────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────

# ── Seceon OTM ─────────────────────────────────────────────────
SECEON_API_KEY=your_seceon_api_key_here

# ── IBM QRadar ──────────────────────────────────────────────────
# Generate via: Admin > Authorized Services > Add
QRADAR_SEC_TOKEN=your_qradar_sec_token_here

# ── FortiSIEM ───────────────────────────────────────────────────
FORTISIEM_USER=your_fortisiem_username
FORTISIEM_PASS=your_fortisiem_password

# ── Other connectors (only the ones you use) ───────────────────────
# SPLUNK_TOKEN=
# SENTINEL_CLIENT_ID=
# SENTINEL_CLIENT_SECRET=
# ELASTIC_API_KEY=
# WAZUH_USER=
# WAZUH_PASS=
# SUMO_ACCESS_ID=
# SUMO_ACCESS_KEY=
# GENERIC_REST_TOKEN=

# ── Alert channels (only the ones you use) ─────────────────────────
# TEAMS_WEBHOOK_URL=
# PAGERDUTY_ROUTING_KEY=
# OPSGENIE_API_KEY=
# SERVICENOW_USER=
# SERVICENOW_PASS=
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# ── Per-client credentials (devices with an auth_ref) ─────────────
# Prefix the variable with the auth_ref in upper case. Example for auth_ref "acme":
# ACME_QRADAR_SEC_TOKEN=acme_qradar_token
# ACME_SECEON_API_KEY=acme_seceon_key
# ACME_FORTISIEM_USER=acme/admin
# ACME_FORTISIEM_PASS=acme_password

# ── Email (SMTP) ────────────────────────────────────────────────
SMTP_PASSWORD=your_smtp_password_here

# ── Slack (Optional) ────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
