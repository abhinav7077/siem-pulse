# ─────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────

# ── Seceon OTM ─────────────────────────────────────────────────
SECEON_API_KEY=your_seceon_api_key_here

# ── IBM QRadar ──────────────────────────────────────────────────
# Generate via: Admin > Authorized Services > Add
QRADAR_SEC_TOKEN=your_qradar_sec_token_here

# ── FortiSIEM ───────────────────────────────────────────────────
FORTISIEM_USER=your_fortisiem_username
FORTISIEM_PASS=your_fortisiem_password

# ── Email (SMTP) ────────────────────────────────────────────────
SMTP_PASSWORD=your_smtp_password_here

# ── Slack (Optional) ────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
