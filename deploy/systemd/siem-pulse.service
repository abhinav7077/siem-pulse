# One check cycle; started by siem-pulse.timer.
# Install: copy to /etc/systemd/system/, then
#   systemctl daemon-reload && systemctl enable --now siem-pulse.timer
[Unit]
Description=SIEM Pulse log source health check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=siempulse
Group=siempulse
WorkingDirectory=/var/lib/siem-pulse
EnvironmentFile=-/etc/siem-pulse/siem-pulse.env
ExecStart=/opt/siem-pulse/venv/bin/siem-pulse --config /etc/siem-pulse/config.yaml
TimeoutStartSec=50min
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/siem-pulse
