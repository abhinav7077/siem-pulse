# Alerts (once) when no check run finished recently. Started by the .timer.
[Unit]
Description=SIEM Pulse self-check

[Service]
Type=oneshot
User=siempulse
Group=siempulse
WorkingDirectory=/var/lib/siem-pulse
EnvironmentFile=-/etc/siem-pulse/siem-pulse.env
ExecStart=/opt/siem-pulse/venv/bin/siem-pulse --config /etc/siem-pulse/config.yaml --check-heartbeat
SuccessExitStatus=2
